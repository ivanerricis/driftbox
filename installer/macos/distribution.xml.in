<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Driftbox @VERSION@</title>
    <organization>com.ivanerricis.driftbox</organization>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <license file="license.txt" mime-type="text/plain"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="clap"/>
        <line choice="au"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plug-in" description="Installs to /Library/Audio/Plug-Ins/VST3" start_selected="true">
        <pkg-ref id="com.ivanerricis.driftbox.vst3"/>
    </choice>
    <choice id="clap" title="CLAP plug-in" description="Installs to /Library/Audio/Plug-Ins/CLAP" start_selected="true">
        <pkg-ref id="com.ivanerricis.driftbox.clap"/>
    </choice>
    <choice id="au" title="Audio Unit plug-in" description="Installs to /Library/Audio/Plug-Ins/Components" start_selected="true">
        <pkg-ref id="com.ivanerricis.driftbox.au"/>
    </choice>

    <pkg-ref id="com.ivanerricis.driftbox.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.ivanerricis.driftbox.clap" version="@VERSION@" onConclusion="none">clap.pkg</pkg-ref>
    <pkg-ref id="com.ivanerricis.driftbox.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
</installer-gui-script>
